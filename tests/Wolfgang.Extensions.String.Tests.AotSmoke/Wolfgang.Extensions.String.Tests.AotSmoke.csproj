<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- The point of this project: prove the library survives Native AOT + trimming end to end.
         If an AOT-hostile pattern (reflection on names the trimmer cannot see, dynamic generic
         instantiation, runtime code generation) gets in, `dotnet publish` here fails with an
         IL2xxx/IL3xxx warning (an error under warnings-as-errors) or the published binary
         faults when it runs (#110). -->
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Not packed and not a test project: publish, then execute. pr.yaml and
         scripts/build-pr.ps1 skip it in their test step. The opt-out is explicit because
         the ARM64 stages' test step fails on a tests/ project that has neither
         Microsoft.NET.Test.Sdk nor IsTestProject=false. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.Extensions.String\Wolfgang.Extensions.String.csproj" />
  </ItemGroup>

</Project>
